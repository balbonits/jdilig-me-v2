---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '@/data/site.config';
import { formatDate } from '@/utils/formatting';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={siteConfig.seo.titleTemplate(post.data.title)}
  description={post.data.description}
  ogImage={post.data.ogImage}
>
  <article class="section-padding">
    <div class="container-page max-w-3xl">
      <a
        href="/blog"
        class="inline-flex items-center gap-1 text-sm text-on-surface-muted hover:text-accent-500 transition-colors mb-8"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        All Posts
      </a>

      <header class="mb-12">
        <time class="text-sm text-on-surface-muted" datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <h1 class="text-3xl md:text-4xl font-bold tracking-tight text-on-surface mt-2 mb-4">
          {post.data.title}
        </h1>
        {post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <span class="badge bg-accent-500/10 text-accent-500">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="prose prose-invert max-w-none
        [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-on-surface [&_h2]:mt-12 [&_h2]:mb-4
        [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-on-surface [&_h3]:mt-8 [&_h3]:mb-3
        [&_p]:text-on-surface-muted [&_p]:leading-relaxed [&_p]:mb-4
        [&_ul]:text-on-surface-muted [&_ul]:space-y-2 [&_ul]:mb-6
        [&_li]:leading-relaxed
        [&_strong]:text-on-surface [&_strong]:font-semibold
        [&_code]:text-accent-400 [&_code]:bg-surface-alt [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-sm
        [&_a]:text-accent-500 [&_a]:link-underline
      ">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
